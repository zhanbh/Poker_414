.access-page {
  padding-top: 120rpx;
}

.subtitle {
  font-size: 28rpx;
  margin-bottom: 56rpx;
}

.access-panel {
  margin: 0 8rpx;
}

.field-label {
  color: #b8d0dc;
  font-size: 26rpx;
  margin: 10rpx 0;
}

.field-input {
  background: #0f2a3b;
  border: 1rpx solid #3a7990;
  border-radius: 12rpx;
  color: #fff;
  height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 22rpx;
}

.server-tip {
  font-size: 22rpx;
  margin: 28rpx 8rpx;
  word-break: break-all;
}
