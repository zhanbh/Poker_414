.texas-game-page {
  padding-top: 54rpx;
}

.game-header {
  margin-bottom: 20rpx;
}

.texas-game-table {
  position: relative;
  min-height: 760rpx;
  margin-top: 26rpx;
  overflow: visible;
  border: 2rpx solid #397a8b;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, #1d6a62 0%, #124b50 62%, #0e3442 100%);
  box-shadow: inset 0 0 0 12rpx rgba(10, 42, 54, .45), 0 18rpx 44rpx rgba(0, 0, 0, .25);
}

.texas-game-table::before {
  content: '';
  position: absolute;
  left: 8%;
  right: 8%;
  top: 10%;
  bottom: 10%;
  border: 2rpx solid rgba(157, 217, 229, .35);
  border-radius: 50%;
  pointer-events: none;
}

.texas-table-center {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: 50%;
  display: flex;
  width: 56%;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
  transform: translate(-50%, -50%);
}

.texas-seat-position {
  position: absolute;
  z-index: 2;
  display: flex;
  width: 190rpx;
  min-height: 132rpx;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx;
  background: rgba(16, 35, 49, .8);
  border: 2rpx solid #397a8b;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, .22);
  transform: translate(-50%, -50%);
}

.texas-seat-A { top: 4%; left: 50%; }
.texas-seat-B { top: 15%; left: 84%; }
.texas-seat-C { top: 50%; left: 96%; transform: translate(-100%, -50%); }
.texas-seat-D { top: 85%; left: 84%; }
.texas-seat-E { top: 96%; left: 50%; transform: translate(-50%, -100%); }
.texas-seat-F { top: 85%; left: 16%; }
.texas-seat-G { top: 50%; left: 4%; transform: translate(0, -50%); }
.texas-seat-H { top: 15%; left: 16%; }
.texas-meta {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
  color: #d1e4eb;
  font-size: 22rpx;
}

.community-panel {
  margin-top: 16rpx;
}

.community-panel .section-title {
  color: #a9c4d1;
  font-size: 24rpx;
}

.card-row {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.texas-card {
  display: inline-flex;
  min-width: 62rpx;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  color: #132431;
  background: #f5f8fc;
  border: 2rpx solid #d6e2ea;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.texas-card.red {
  color: #c62828;
}

.texas-card.small {
  min-width: 52rpx;
  height: 70rpx;
  font-size: 24rpx;
}

.texas-player {
  gap: 6rpx;
  padding: 14rpx;
  background: rgba(16, 35, 49, .8);
  border: 2rpx solid #397a8b;
}

.texas-player.current {
  border-color: #ffd166;
  box-shadow: 0 0 0 2rpx rgba(255, 209, 102, .2);
}

.texas-player > view:first-child {
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
}

.texas-player .waiting {
  color: #9dd9e5;
}

.texas-player .seat {
  margin-right: 10rpx;
  color: #ffd166;
}

.texas-player .muted {
  font-size: 20rpx;
}

.host {
  color: #f0b44d;
}

.folded {
  color: #ff9aa4;
}

.hand-panel,
.action-panel,
.settlement-panel {
  margin-top: 20rpx;
}

.spectator-hand {
  margin-top: 14rpx;
  padding: 14rpx;
  background: #1e5368;
  border-radius: 12rpx;
}

.spectator-hand-title {
  font-weight: 700;
}

.bet-slider {
  margin: 18rpx 0;
}

.action-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.action-row button {
  flex: 1;
  min-width: 160rpx;
}

.settlement-panel .primary-button {
  margin-top: 22rpx;
}
