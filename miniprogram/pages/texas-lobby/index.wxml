<view class="page texas-lobby-page">
  <view class="game-header">
    <view class="title">德州扑克房间</view>
    <view class="muted">两人以上即可开始 · 1000 筹码 · 盲注 10/20</view>
  </view>
  <view class="room-purpose-notice" role="note">
    <text class="room-purpose-title">测试学习交流声明</text>
    <text>本房间仅用于游戏测试、学习与交流；虚拟筹码不具有现金或财产价值，不涉及充值、提现、现金输赢或奖励兑换，请勿用于赌博或其他违法活动。</text>
  </view>

  <view class="texas-lobby-table" aria-label="德州扑克座位">
    <view class="texas-table-felt">
      <view class="texas-table-title">德州扑克</view>
      <view>{{playerCount}} 人已入座 · 至少 2 人开局</view>
      <view class="muted table-note">后加入者优先占用空位，等待下一局</view>
      <button wx:if="{{isHost}}" class="primary-button table-start-button" disabled="{{playerCount < 2}}" bindtap="onStart">开始牌局</button>
    </view>

    <view wx:for="{{players}}" wx:key="seat" class="texas-seat texas-seat-position texas-seat-{{item.seat}} {{item.nickname ? 'occupied' : ''}}">
      <view class="seat-title"><text class="seat">{{item.positionLabel}}</text></view>
      <view wx:if="{{item.nickname}}" class="seat-name">{{item.nickname}}</view>
      <view wx:if="{{item.nickname}}" class="muted">筹码 {{item.stack}}</view>
      <view wx:if="{{item.isHost}}" class="host">房主</view>
      <view wx:if="{{item.waiting}}" class="waiting">等待下一局</view>
      <view wx:if="{{item.nickname && !item.connected}}" class="muted">已断开</view>
      <button wx:if="{{item.canKick}}" class="danger-button texas-seat-remove" data-seat="{{item.seat}}" bindtap="onRemove">{{isHost ? '移除' : '踢出'}}</button>
    </view>
  </view>

  <view wx:if="{{spectator}}" class="spectator-banner">观战模式 · 等待本局结束或下一局入座</view>
  <view wx:if="{{spectators.length}}" class="panel spectator-panel">
    <view class="section-title">观战席（{{spectators.length}}/4）</view>
    <view wx:for="{{spectators}}" wx:key="nickname" class="spectator-row">{{item.nickname}}<text wx:if="{{item.waiting}}"> · 等待下一局</text></view>
  </view>

  <view class="panel status-panel">
    <view>当前玩家：{{playerCount}} / 8</view>
    <view wx:if="{{isHost && playerCount < 2}}" class="muted hint">至少需要两名玩家</view>
    <view wx:if="{{!isHost}}" class="muted hint">等待房主开始，后加入者将在下一局入座</view>
    <button class="leave-button" bindtap="onLeave">退出房间</button>
  </view>

  <room-chat messages="{{chat}}" members="{{chatMembers}}" own-seat="{{ownSeat}}" bind:send="onChatSend" />

  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
