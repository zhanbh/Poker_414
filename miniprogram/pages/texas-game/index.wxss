.texas-game-page {
  padding-top: 54rpx;
}

.game-header {
  margin-bottom: 20rpx;
}

.texas-game-table {
  min-height: 760rpx;
  margin-top: 26rpx;
}

.texas-meta {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
  color: #d1e4eb;
  font-size: 22rpx;
}

.community-panel {
  margin-top: 16rpx;
}

.community-panel .section-title {
  color: #a9c4d1;
  font-size: 24rpx;
}

.card-row {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.texas-card {
  display: inline-flex;
  min-width: 62rpx;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  color: #132431;
  background: #f5f8fc;
  border: 2rpx solid #d6e2ea;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.texas-card.red {
  color: #c62828;
}

.texas-card.small {
  min-width: 52rpx;
  height: 70rpx;
  font-size: 24rpx;
}

.texas-player {
  gap: 6rpx;
  padding: 14rpx;
  background: rgba(16, 35, 49, .8);
  border: 2rpx solid #397a8b;
}

.texas-player.current {
  border-color: #ffd166;
  box-shadow: 0 0 0 2rpx rgba(255, 209, 102, .2);
}

.texas-player > view:first-child {
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
}

.texas-player .seat {
  margin-right: 10rpx;
  color: #ffd166;
}

.texas-player .muted {
  font-size: 20rpx;
}

.host {
  color: #f0b44d;
}

.folded {
  color: #ff9aa4;
}

.hand-panel,
.action-panel,
.settlement-panel {
  margin-top: 20rpx;
}

.spectator-hand {
  margin-top: 14rpx;
  padding: 14rpx;
  background: #1e5368;
  border-radius: 12rpx;
}

.spectator-hand-title {
  font-weight: 700;
}

.bet-slider {
  margin: 18rpx 0;
}

.action-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.action-row button {
  flex: 1;
  min-width: 160rpx;
}

.settlement-panel .primary-button {
  margin-top: 22rpx;
}
