.player-badge.listening { position: absolute; z-index: 3; top: -8rpx; left: 19rpx; width: 42rpx; height: 42rpx; color: #063b36; background: linear-gradient(145deg, #b8fff0, #45d2b9); border: 4rpx solid #f4fffc; box-shadow: 0 0 0 5rpx rgba(69, 210, 185, .35), 0 4rpx 10rpx rgba(0, 0, 0, .35); font-size: 23rpx; transform: rotate(-10deg); }
.mahjong-seat-top .player-card { top: 1.5%; left: 50%; transform: translateX(-50%); }
.mahjong-seat-left .player-card { top: 50%; left: 1.5%; width: 27%; transform: translateY(-50%); }
.mahjong-seat-right .player-card { top: 50%; right: 1.5%; width: 27%; transform: translateY(-50%); }
.mahjong-seat-bottom .player-card { bottom: 1.5%; left: 1.5%; width: 205rpx; }
.mahjong-seat.current .player-card { border-color: #ffd166; box-shadow: 0 0 0 4rpx rgba(255, 209, 102, .3), 0 3rpx 8rpx rgba(0, 0, 0, .16); }
.mahjong-seat.responding .player-card { border-color: #59d7c1; box-shadow: 0 0 0 4rpx rgba(89, 215, 193, .3), 0 3rpx 8rpx rgba(0, 0, 0, .16); }
.seat-melds, .meld-tiles, .revealed-seat-hand, .own-melds, .chi-tiles { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 2rpx; }
.seat-melds { position: absolute; z-index: 2; gap: 5rpx; pointer-events: auto; }
