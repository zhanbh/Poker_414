}
.mahjong-wall-label { position: absolute; z-index: 1; bottom: 20%; left: 50%; padding: 3rpx 10rpx; color: #c4e0df; background: rgba(9, 43, 48, .62); border-radius: 18rpx; font-size: 17rpx; letter-spacing: 2rpx; transform: translateX(-50%); pointer-events: none; }
.mahjong-tile-face.drawn-tile { margin-left: 16rpx; }
.mahjong-seat-bottom .listen-preview { position: absolute; z-index: 4; right: 1.5%; bottom: 19%; left: 23%; display: flex; min-height: 44rpx; flex-wrap: wrap; align-items: center; gap: 5rpx; padding: 5rpx 8rpx; color: #dceff0; background: rgba(9, 43, 48, .95); border: 2rpx solid rgba(89, 215, 193, .72); border-radius: 8rpx; font-size: 18rpx; box-sizing: border-box; }
.listen-preview-title { color: #8ce7d9; font-weight: 700; }
.listen-preview .mahjong-tile-face { width: 29rpx; height: 42rpx; }
.listen-preview .face-rank, .listen-preview .face-suit { display: none; }
.listen-preview .face-character, .listen-preview .face-honor { font-size: 23rpx; }
.listen-preview .tile-motif { width: 6rpx; height: 6rpx; }
.listen-preview .tile-motif.suo { width: 4rpx; height: 13rpx; }
.bao-preview { display: inline-flex; align-items: center; gap: 4rpx; margin-left: 5rpx; color: #ffd166; }
.bao-preview > text { padding: 3rpx 8rpx; border: 2rpx solid rgba(255, 209, 102, .7); border-radius: 18rpx; }
.face-character { gap: 0; }
.face-character text:first-child { font-size: .43em; }
.face-character text:last-child { font-size: 1em; }
.face-honor { color: #354d83; }
.mahjong-tile-face.dragon-red .face-honor { color: #c62828; }
.mahjong-tile-face.dragon-green .face-honor { color: #168052; }
.mahjong-tile-face.dragon-white .face-honor { color: #536d8c; }
.tile-motif.pip-green { color: #20835a; }
.tile-motif.pip-blue { color: #276bb2; }
.tile-motif.pip-red { color: #c52d2d; }
.tile-motif.tong { background: transparent; border: 2rpx solid currentColor; box-shadow: inset 0 0 0 1rpx currentColor; }
.tile-motif.tong::after { position: absolute; top: 25%; right: 25%; bottom: 25%; left: 25%; content: ''; background: currentColor; border-radius: 50%; }
@media screen and (max-width: 520px) {
  .mahjong-wall-label { bottom: 20%; font-size: 15rpx; }
  .mahjong-tile-face.drawn-tile { margin-left: 12rpx; }
