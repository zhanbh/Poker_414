<view class="page access-page">
  <view class="title">选择玩法</view>
  <view class="muted subtitle">先选择游戏，再进入对应的私房房间</view>

  <view class="game-picker">
    <view
      wx:for="{{gameOptions}}"
      wx:key="id"
      class="game-card {{item.id === gameId ? 'selected' : ''}}"
      data-game-id="{{item.id}}"
      bindtap="onGameChange"
    >
      <view class="game-card-title">{{item.name}}</view>
      <view class="game-card-description">{{item.description}}</view>
      <view class="game-card-meta">{{item.id === 'texas' ? '最多 8 人入座 · 牌局中后加入下一局；优先占用空位' : item.maxPlayers + ' 人桌 · 满员后自动观战'}}</view>
    </view>
  </view>

  <view class="panel access-panel">
    <view class="selected-game-title">{{gameId === 'texas' ? '德州扑克' : '414'}} 内测</view>
    <view class="muted selected-game-description">{{gameId === 'texas' ? '两人以上即可开局，后加入者等待下一局' : '四人私房扑克牌'}} · 邀请制</view>
    <view class="field-label">邀请码</view>
    <input class="field-input" placeholder="请输入固定邀请码" value="{{inviteCode}}" bindinput="onInviteCodeInput" />
    <view class="field-label">昵称</view>
    <input class="field-input" maxlength="12" placeholder="请输入本局昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    <view class="join-mode-hint">有空位自动成为玩家；牌局中加入优先占空位并等待下一局</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary-button" loading="{{busy}}" disabled="{{busy}}" bindtap="onSubmit">进入房间</button>
  </view>

  <view class="server-tip muted">当前服务地址：{{serverOrigin}}</view>
</view>
