<view class="page lobby-page">
  <view class="title">414 房间 {{roomId}}</view>
  <view class="muted">等待四名玩家到齐后，由房主开始游戏</view>
  <view class="room-purpose-notice" role="note">
    <text class="room-purpose-title">测试学习交流声明</text>
    <text>本房间仅用于游戏测试、学习与交流；虚拟筹码不具有现金或财产价值，不涉及充值、提现、现金输赢或奖励兑换，请勿用于赌博或其他违法活动。</text>
  </view>

  <view class="team-grid">
    <view class="panel team-panel">
      <view class="team-title">1队</view>
      <view wx:for="{{ac}}" wx:key="seat" class="player-row">
        <view>
          <text class="seat">{{item.seat}}</text>
          <text class="nickname">{{item.nickname || '空位'}}</text>
          <text wx:if="{{item.isHost}}" class="host">房主</text>
          <text wx:if="{{!item.connected && item.nickname}}" class="muted"> · 已断开</text>
        </view>
        <button wx:if="{{isHost && item.nickname && item.seat !== ownSeat}}" class="danger-button" data-seat="{{item.seat}}" bindtap="onRemove">移除</button>
      </view>
    </view>
    <view class="panel team-panel">
      <view class="team-title">2队</view>
      <view wx:for="{{bd}}" wx:key="seat" class="player-row">
        <view>
          <text class="seat">{{item.seat}}</text>
          <text class="nickname">{{item.nickname || '空位'}}</text>
          <text wx:if="{{item.isHost}}" class="host">房主</text>
          <text wx:if="{{!item.connected && item.nickname}}" class="muted"> · 已断开</text>
        </view>
        <button wx:if="{{isHost && item.nickname && item.seat !== ownSeat}}" class="danger-button" data-seat="{{item.seat}}" bindtap="onRemove">移除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{spectator}}" class="spectator-banner">观战模式 · 等待四名玩家开局</view>
  <view wx:if="{{spectators.length}}" class="panel spectator-panel">
    <view class="section-title">观战席（{{spectators.length}}/4）</view>
    <view wx:for="{{spectators}}" wx:key="nickname" class="spectator-row">{{item.nickname}}<text wx:if="{{!item.connected}}"> · 已断开</text></view>
  </view>

  <view class="panel status-panel">
    <view>当前人数：{{playerCount}} / 4</view>
    <button wx:if="{{isHost}}" class="primary-button" disabled="{{!full}}" bindtap="onStart">开始游戏</button>
    <view wx:if="{{isHost && !full}}" class="muted hint">还需要等待其他玩家加入</view>
    <view wx:if="{{!isHost}}" class="muted hint">等待房主开始</view>
    <button class="leave-button" bindtap="onLeave">退出房间</button>
  </view>

  <room-chat messages="{{chat}}" members="{{chatMembers}}" own-seat="{{ownSeat}}" bind:send="onChatSend" />

  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
