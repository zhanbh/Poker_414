<view class="page mahjong-game-page">
  <view class="game-header"><view class="title">麻将对局</view><view class="muted">第 {{snapshot.public.handNumber}} 局 · 牌墙剩余 {{wallCount}} 张</view><view class="turn-status {{isResponsePhase ? 'response-phase' : isMyTurn ? 'my-turn' : ''}}">{{turnStatus}}</view></view>
  <view class="room-purpose-notice" role="note"><text class="room-purpose-title">测试学习交流声明</text><text>本房间仅用于游戏测试、学习与交流；虚拟积分仅供娱乐，不具有现金或财产价值。</text></view>
  <view wx:if="{{spectator}}" class="spectator-banner">观战模式 · 查看牌桌状态</view>
  <view class="mahjong-table {{settlement ? 'is-settled' : ''}}" style="height:{{boardSize}}px">
    <view wx:for="{{wallSides}}" wx:key="seat" class="mahjong-wall mahjong-wall-{{item.position}} {{item.isBreakSide ? 'break-side' : ''}}" aria-label="玩家面前剩余牌墙"><view wx:for="{{item.stacks}}" wx:for-item="stack" wx:key="id" class="mahjong-wall-stack {{stack.isDouble ? 'double' : ''}}"><view class="tile-back {{stack.replacement ? 'replacement' : ''}}"><view></view></view></view></view>
    <view class="mahjong-table-drop-zone" catchtap="onTableTap"></view>
    <view wx:for="{{players}}" wx:key="seat" class="mahjong-seat mahjong-seat-{{item.position}} {{item.seat === currentTurn && !isResponsePhase ? 'current' : ''}} {{item.seat === ownSeat && canRespondNow ? 'responding' : ''}}">
      <view class="player-card"><view class="player-avatar">{{item.avatarLabel}}</view><view class="player-meta"><text class="player-name">{{item.nickname}}</text><text class="player-subtitle">{{item.score}} 分</text></view><text wx:if="{{item.isDealer}}" class="player-badge dealer">庄</text><text wx:if="{{item.isListening}}" class="player-badge listening">听</text></view>
      <view wx:if="{{item.melds.length}}" class="seat-melds"><view wx:for="{{item.melds}}" wx:for-item="meld" wx:key="index" class="mahjong-meld"><text>{{meld.kind === 'chi' ? '吃' : meld.kind === 'peng' ? '碰' : meld.kind === 'concealed-kong' ? '暗杠' : '杠'}}</text><view class="meld-tiles"><template is="tileFace" wx:for="{{meld.tiles}}" wx:for-item="tile" wx:key="id" data="{{tile}}" /><view wx:for="{{meld.hiddenBacks}}" wx:for-item="back" wx:key="*this" class="tile-back"><view></view></view></view></view></view>
      <view wx:if="{{item.revealedHand.length && item.seat !== ownSeat}}" class="revealed-seat-hand"><template is="tileFace" wx:for="{{item.revealedHand}}" wx:for-item="tile" wx:key="id" data="{{tile}}" /></view>
      <view wx:if="{{item.seat !== ownSeat && !item.revealedHand.length && item.handCount}}" class="concealed-seat-hand" aria-label="{{item.nickname}}的未公开手牌"><view wx:for="{{item.concealedTiles}}" wx:for-item="edge" wx:key="*this" class="tile-edge"></view></view>
      <view wx:if="{{item.seat === ownSeat && !spectator}}" class="own-hand" aria-label="我的手牌"><view wx:for="{{hand}}" wx:for-item="tile" wx:key="id" class="mahjong-tile-face {{tile.tileClass}} {{tile.selected ? 'selected' : ''}} {{tile.listenOption ? 'listen-option' : ''}} {{tile.drawn ? 'drawn-tile' : ''}}" data-id="{{tile.id}}" catchtap="onTileTap" bindtouchstart="onTileTouchStart" bindtouchmove="onTileTouchMove" bindtouchend="onTileTouchEnd"><view class="tile-face-art"><image src="/assets/mahjong-tiles.png" mode="scaleToFill" style="left:{{tile.spriteLeft}}%;top:{{tile.spriteTop}}%"></image></view></view></view>
      <view wx:if="{{item.seat === ownSeat && listenPreview}}" class="listen-preview"><text class="listen-preview-title">{{isListening ? '已听牌' : '打出此牌可听'}} · 胡：</text><template is="tileFace" wx:for="{{listenPreview.waits}}" wx:for-item="wait" wx:key="id" data="{{wait}}"/><view wx:if="{{isListening && listenPreview.baoTile}}" class="bao-preview"><text>宝</text><template is="tileFace" data="{{listenPreview.baoTile}}"/></view></view>
      <view wx:if="{{item.seat === ownSeat && !spectator && ((isResponsePhase && (canRespondNow || canPass)) || (isMyTurn && ((!isListening && (canListen || canConcealedKong || canAddedKong)) || (isListening && canHu))))}}" class="mahjong-action-dock">
        <block wx:if="{{isResponsePhase}}"><button wx:if="{{canHu}}" class="mahjong-action-circle" data-action="hu" catchtap="onAction">胡</button><button wx:if="{{canPeng}}" class="mahjong-action-circle" data-action="peng" catchtap="onAction">碰</button><button wx:if="{{canChi}}" class="mahjong-action-circle" data-action="chi-intent" catchtap="onAction">吃</button><button wx:if="{{canKong}}" class="mahjong-action-circle" data-action="exposed-kong" catchtap="onAction">杠</button><button wx:if="{{canPass}}" class="mahjong-action-circle secondary" data-action="pass" catchtap="onAction">过</button>
          <view wx:if="{{chiPickerOpen && chiOptions.length > 1}}" class="mahjong-chi-picker"><button wx:for="{{chiOptions}}" wx:key="key" class="chi-choice" data-action="chi" data-index="{{index}}" catchtap="onAction"><view class="chi-tiles"><template is="tileFace" wx:for="{{item.tiles}}" wx:for-item="tile" wx:key="id" data="{{tile}}"/></view></button></view>
        </block>
        <block wx:elif="{{isListening}}"><button class="mahjong-action-circle" data-action="hu" catchtap="onAction">胡</button><button class="mahjong-action-circle secondary" data-action="pass" catchtap="onAction">过</button></block>
        <block wx:else><button wx:if="{{canListen}}" class="mahjong-action-circle" disabled="{{!canListenSelected}}" data-action="listen" catchtap="onAction">听</button><button wx:if="{{canConcealedKong}}" class="mahjong-action-circle" data-action="concealed-kong" catchtap="onAction">暗杠</button><button wx:if="{{canAddedKong}}" class="mahjong-action-circle" disabled="{{!selectedTileId}}" data-action="added-kong" catchtap="onAction">补杠</button></block>
      </view>
    </view>
    <view class="mahjong-discard-pile" aria-label="公共弃牌区" catchtap="onTableTap"><view class="discard-pile-tiles"><template is="tileFace" wx:for="{{discardRiver}}" wx:for-item="tile" wx:key="id" data="{{tile}}" /></view></view>
    <view wx:if="{{settlement}}" class="mahjong-settlement mahjong-table-settlement" role="status"><view class="section-title">本局结束</view><view>{{settlementDescription}}</view><view wx:if="paymentRows.length" class="mahjong-payment-row"><text wx:for="{{paymentRows}}" wx:key="seat">{{item.nickname}} {{item.amountLabel}} </text></view><button wx:if="{{settlement.type !== 'draw' && ownSeat === snapshot.public.hostSeat}}" class="primary-button" data-action="next-hand" bindtap="onAction">开始下一局</button><text wx:elif="{{settlement.type !== 'draw'}}" class="settlement-waiting">等待房主开始下一局</text><text wx:else class="settlement-waiting">即将开始下一局</text></view>
    <view wx:if="{{animationStage}}" class="mahjong-animation {{animationStage}}"><view class="dice-cube">{{diceLabel}}</view><text>{{animationStage === 'dice' ? '庄家掷骰' : '正在发牌'}}</text><view wx:if="{{animationStage === 'deal'}}" class="dealing-tiles"><view class="tile-back"><view></view></view><view class="tile-back"><view></view></view><view class="tile-back"><view></view></view><view class="tile-back"><view></view></view></view></view>
  </view>
  <view wx:if="{{autoDiscardPending}}" class="auto-discard-note">听牌自动摸切中…</view>
  <button class="leave-button" bindtap="onLeave">退出房间</button>
  <room-chat messages="{{chat}}" members="{{chatMembers}}" own-seat="{{ownSeat}}" bind:send="onChatSend" />
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>

<template name="tileFace">
  <view class="mahjong-tile-face compact {{tileClass}} {{isPendingDiscard ? 'pending-discard' : ''}}"><view class="tile-face-art"><image src="/assets/mahjong-tiles.png" mode="scaleToFill" style="left:{{spriteLeft}}%;top:{{spriteTop}}%"></image></view></view>
</template>
