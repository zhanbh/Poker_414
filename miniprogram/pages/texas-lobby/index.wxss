.texas-lobby-page {
  padding-top: 60rpx;
}

.game-header {
  margin-bottom: 30rpx;
}

.seat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.texas-seat {
  min-height: 170rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.texas-seat.occupied {
  border-color: #70a9b4;
}

.seat-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.seat-title .seat {
  color: #f0b44d;
}

.host {
  color: #f0b44d;
}

.spectator-panel {
  margin-top: 22rpx;
}

.spectator-row {
  background: #1e5368;
  border-radius: 10rpx;
  margin-top: 10rpx;
  padding: 14rpx;
}

.status-panel {
  margin-top: 24rpx;
}

.hint {
  margin-top: 18rpx;
}
