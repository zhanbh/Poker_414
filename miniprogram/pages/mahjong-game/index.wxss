  .listen-preview .face-character, .listen-preview .face-honor { font-size: 19rpx; }
}

/* Mahjong table: seat-relative physical wall and compact floating action dock. */
.mahjong-wall { z-index: 1; display: flex; gap: 1rpx; align-items: center; justify-content: center; }
.mahjong-wall-top { top: 8%; right: 18%; left: 18%; }
.mahjong-wall-bottom { right: 18%; bottom: 16%; left: 18%; }
.mahjong-wall-left, .mahjong-wall-right { top: 22%; bottom: 22%; flex-direction: column; }
.mahjong-wall-left { left: 12%; }
.mahjong-wall-right { right: 12%; }
.mahjong-wall-stack { display: flex; flex: 0 0 auto; flex-direction: column; gap: 1rpx; }
.mahjong-wall-left .mahjong-wall-stack, .mahjong-wall-right .mahjong-wall-stack { flex-direction: row; }
.mahjong-wall .tile-back { width: 21rpx; height: 30rpx; padding: 2rpx; border-width: 1rpx; border-bottom-width: 2rpx; border-radius: 3rpx; }
.mahjong-wall-left .tile-back, .mahjong-wall-right .tile-back { width: 16rpx; height: 30rpx; }
.mahjong-wall .tile-back.replacement { border-color: #ffd166; box-shadow: 0 0 0 2rpx rgba(255, 209, 102, .58); }
.mahjong-table-drop-zone { position: absolute; z-index: 1; top: 28%; right: 23%; bottom: 26%; left: 23%; }
.mahjong-seat-left .revealed-seat-hand .mahjong-tile-face { transform: rotate(90deg); }
.mahjong-seat-right .revealed-seat-hand .mahjong-tile-face { transform: rotate(-90deg); }
.mahjong-action-dock { position: absolute; z-index: 5; right: 2%; bottom: 20%; display: flex; max-width: 48%; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8rpx; }
.mahjong-action-circle { display: grid; flex: 0 0 66rpx; width: 66rpx; height: 66rpx; place-items: center; margin: 0; padding: 0; color: #fff4d3; background: rgba(13, 57, 59, .48); border: 3rpx solid #ffd166; border-radius: 50%; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .18); font-size: 24rpx; font-weight: 800; line-height: 1; }
.mahjong-action-circle.secondary { color: #c5d8dc; border-color: rgba(197, 216, 220, .62); }
.mahjong-action-circle[disabled] { opacity: .38; }
.mahjong-chi-picker { position: absolute; right: 0; bottom: calc(100% + 8rpx); display: flex; max-width: 82vw; flex-wrap: wrap; justify-content: flex-end; gap: 4rpx; padding: 8rpx; background: rgba(10, 35, 43, .94); border: 2rpx solid rgba(255, 209, 102, .72); border-radius: 10rpx; }
.mahjong-chi-picker .chi-choice { padding: 2rpx; background: transparent; border: 0; }
.mahjong-chi-picker .mahjong-tile-face { width: 34rpx; height: 49rpx; }
.mahjong-wall-label { display: none; }
@media screen and (max-width: 520px) {
  .mahjong-wall-top { top: 8%; right: 15%; left: 15%; }
  .mahjong-wall-bottom { right: 15%; bottom: 16%; left: 15%; }
  .mahjong-wall .tile-back { width: 22rpx; height: 32rpx; padding: 1rpx; }
  .mahjong-wall-left, .mahjong-wall-right { top: 8%; bottom: 8%; }
  .mahjong-wall-left .tile-back, .mahjong-wall-right .tile-back { width: 16rpx; height: 30rpx; }
  .mahjong-action-dock { right: 1%; bottom: 20%; max-width: 50%; gap: 4rpx; }
  .mahjong-action-circle { flex-basis: 54rpx; width: 54rpx; height: 54rpx; border-width: 2rpx; font-size: 19rpx; }
  .mahjong-table-drop-zone { right: 19%; left: 19%; }
}

.mahjong-tile-face, .mahjong-seat .mahjong-tile-face, .mahjong-meld .mahjong-tile-face { overflow: hidden; padding: 0; background: #fffdf7; }
.tile-face-art { position: relative; display: block; flex: 1; width: 100%; height: 100%; overflow: hidden; }
.tile-face-art image { position: absolute; display: block; width: 900%; height: 400%; }
.mahjong-seat-bottom .own-hand .mahjong-tile-face { height: 54rpx; }

.mahjong-wall-top { top: 23%; right: 18%; left: 18%; }
.mahjong-wall-bottom { right: 18%; bottom: 17%; left: 18%; }
.mahjong-wall-left, .mahjong-wall-right { top: 15%; bottom: 15%; }
.mahjong-wall-left { left: 26%; }
.mahjong-wall-right { right: 26%; }
.mahjong-wall-stack { position: relative; display: block; }
.mahjong-wall-stack.double::before { position: absolute; top: 3rpx; right: -2rpx; bottom: -3rpx; left: 2rpx; content: ''; background: #b8ab90; border: 1rpx solid #95896f; border-radius: 3rpx; box-shadow: 0 2rpx 3rpx rgba(0, 0, 0, .24); }
.mahjong-wall-left .mahjong-wall-stack.double::before { top: 2rpx; right: -3rpx; bottom: 0; left: 2rpx; }
.mahjong-wall-right .mahjong-wall-stack.double::before { top: 2rpx; right: 2rpx; bottom: 0; left: -3rpx; }
.mahjong-wall-stack .tile-back { position: relative; }
.mahjong-wall-left .mahjong-wall-stack, .mahjong-wall-right .mahjong-wall-stack { width: 30rpx; height: 21rpx; }
.mahjong-wall-left .tile-back, .mahjong-wall-right .tile-back { width: 30rpx; height: 21rpx; padding: 2rpx; }
.tile-edge { display: block; flex: 0 0 auto; width: 16rpx; height: 9rpx; background: linear-gradient(#fffdf5, #d5cebb); border: 1rpx solid #afa790; border-bottom: 2rpx solid #938a74; border-radius: 2rpx; box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, .22); box-sizing: border-box; }
.concealed-seat-hand { position: absolute; z-index: 2; display: flex; gap: 2rpx; align-items: center; pointer-events: none; }
.mahjong-seat-top .concealed-seat-hand { top: 10%; left: 50%; transform: translateX(-50%); }
.mahjong-seat-left .concealed-seat-hand, .mahjong-seat-right .concealed-seat-hand { top: 50%; flex-direction: column; gap: 1rpx; transform: translateY(-50%); }
.mahjong-seat-left .concealed-seat-hand { left: 24%; }
.mahjong-seat-right .concealed-seat-hand { right: 24%; }
.mahjong-seat-left .concealed-seat-hand .tile-edge, .mahjong-seat-right .concealed-seat-hand .tile-edge { width: 9rpx; height: 16rpx; border-right-width: 2rpx; border-bottom-width: 1rpx; }
.mahjong-seat-top .revealed-seat-hand { top: 10%; }
.mahjong-seat-left .revealed-seat-hand, .mahjong-seat-right .revealed-seat-hand { top: 50%; bottom: auto; max-height: 70%; overflow-y: auto; transform: translateY(-50%); }
.mahjong-seat-left .revealed-seat-hand { left: 24%; }
.mahjong-seat-right .revealed-seat-hand { right: 24%; }
.mahjong-seat-left .revealed-seat-hand .mahjong-tile-face, .mahjong-seat-right .revealed-seat-hand .mahjong-tile-face { width: 19rpx; height: 27rpx; }
.mahjong-seat-left .player-card, .mahjong-seat-right .player-card { width: 22%; }
.mahjong-seat-left .player-subtitle, .mahjong-seat-right .player-subtitle { font-size: 17rpx; }
.mahjong-discard-pile { right: 37%; left: 37%; }
.mahjong-table-drop-zone { right: 32%; left: 32%; }

@keyframes mahjong-action-appear { from { opacity: 0; transform: translateY(12rpx) scale(.88); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes mahjong-action-breathe { 50% { box-shadow: 0 0 0 5rpx rgba(255, 209, 102, .18), 0 6rpx 18rpx rgba(255, 198, 83, .3); } }
.mahjong-action-dock { bottom: 12%; gap: 8rpx; }
.mahjong-action-circle { color: #fff7df; background: linear-gradient(145deg, #397d76, #0d383d 75%); border-color: #eac268; box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, .25), 0 6rpx 16rpx rgba(0, 0, 0, .35); animation: mahjong-action-appear .26s ease-out, mahjong-action-breathe 2.6s ease-in-out 1s infinite; }
.mahjong-action-circle::after { border: 0; }
.mahjong-action-circle.secondary { background: linear-gradient(145deg, #47636b, #182f38 75%); animation: mahjong-action-appear .26s ease-out; }
.mahjong-action-circle:active { transform: scale(.94); }
.mahjong-action-circle[disabled] { animation: none; }
@media screen and (max-width: 520px) {
  .mahjong-wall-top { top: 25%; }
  .mahjong-wall-bottom { bottom: 25%; }
  .mahjong-wall-left, .mahjong-wall-right { top: 25%; bottom: 25%; }
  .mahjong-wall-left { left: 28%; }
  .mahjong-wall-right { right: 28%; }
  .mahjong-wall .tile-back { width: 20rpx; height: 28rpx; }
  .mahjong-wall-left .mahjong-wall-stack, .mahjong-wall-right .mahjong-wall-stack { width: 28rpx; height: 20rpx; }
  .mahjong-wall-left .tile-back, .mahjong-wall-right .tile-back { width: 28rpx; height: 20rpx; }
  .mahjong-seat-top .concealed-seat-hand { top: 17%; }
  .mahjong-discard-pile { right: 37%; left: 37%; }
  .mahjong-table.is-settled .mahjong-discard-pile { top: 33%; }
}
