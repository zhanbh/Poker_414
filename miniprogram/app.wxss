page {
  background: #0e2535;
  color: #eef7ff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  min-height: 100%;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  border-radius: 12rpx;
  margin: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
}

.panel {
  background: #16394d;
  border: 1rpx solid #2e7189;
  border-radius: 20rpx;
  padding: 28rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.muted {
  color: #a9c4d1;
}

.room-purpose-notice {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 16rpx 0;
  padding: 14rpx 18rpx;
  color: #d9edf2;
  background: rgba(18, 61, 76, .96);
  border: 1rpx solid #4a9caf;
  border-radius: 12rpx;
  font-size: 20rpx;
  line-height: 1.45;
}

.room-purpose-title {
  flex: 0 0 auto;
  color: #ffd166;
  font-weight: 700;
}

.error {
  background: #5a2930;
  border: 1rpx solid #d56f79;
  border-radius: 12rpx;
  color: #ffe5e7;
  margin: 20rpx 0;
  padding: 18rpx;
}

.primary-button {
  background: #f0b44d;
  color: #1d2830;
  font-weight: 700;
  margin-top: 24rpx;
}

.secondary-button {
  background: #235d73;
  color: #eef7ff;
  margin-top: 16rpx;
}

.danger-button {
  background: #7e3942;
  color: #fff;
  font-size: 24rpx;
  padding: 0 18rpx;
}
