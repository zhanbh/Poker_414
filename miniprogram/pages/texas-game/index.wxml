<view class="page texas-game-page">
  <view class="game-header">
    <view class="title">德州扑克</view>
    <view class="muted">第 {{handNumber}} 局 · {{phaseLabel}}</view>
  </view>
  <view class="room-purpose-notice" role="note">
    <text class="room-purpose-title">测试学习交流声明</text>
    <text>本房间仅用于游戏测试、学习与交流；虚拟筹码不具有现金或财产价值，不涉及充值、提现、现金输赢或奖励兑换，请勿用于赌博或其他违法活动。</text>
  </view>

  <view wx:if="{{spectator}}" class="spectator-banner">{{waiting ? '等待本局结束 · 下一局自动入座' : '观战模式 · 上帝视角 · 可查看所有手牌'}}</view>
  <button class="leave-button" bindtap="onLeave">退出房间</button>

  <view class="texas-game-table" aria-label="德州扑克牌桌">
    <view class="texas-table-center">
      <view class="texas-meta">
        <text>底池 {{pot}}</text>
        <text>当前下注 {{currentBet}}</text>
        <text>轮到 {{currentTurnLabel || '—'}}</text>
      </view>
      <view class="phase-notice">{{phaseNotice}}</view>

      <view class="community-panel">
        <view class="section-title">公共牌</view>
        <view class="card-row">
          <view wx:for="{{community}}" wx:key="id" class="texas-card texas-card-deal {{item.red ? 'red' : ''}}">{{item.label}}</view>
          <view wx:if="{{!community.length}}" class="muted">等待发牌</view>
        </view>
      </view>
    </view>

    <view wx:for="{{players}}" wx:if="{{item.nickname}}" wx:key="seat" class="texas-player texas-seat-position texas-seat-{{item.seat}} {{item.seat === currentTurn ? 'current' : ''}}">
      <view><text class="seat">{{item.positionLabel}}</text><text>{{item.nickname}}</text></view>
      <view class="muted">筹码 {{item.stack}}</view>
      <view class="muted">本轮下注 {{item.roundBet}}</view>
      <view wx:if="{{item.waiting}}" class="waiting">等待下一局</view>
      <view wx:if="{{item.folded}}" class="folded">已弃牌</view>
      <view wx:if="{{item.allIn}}" class="host">All-in</view>
      <view wx:if="{{item.isHost}}" class="host">房主</view>
    </view>
  </view>

  <view class="panel hand-panel">
    <view class="section-title">{{spectator || phase === 'showdown' || phase === 'settled' ? '玩家手牌（上帝视角）' : '我的手牌'}}</view>
    <view wx:if="{{!spectator && bestHand}}" class="best-hand">当前最佳牌型：<text>{{bestHand.label}}</text></view>
    <view wx:if="{{!spectator && !bestHand && community.length < 3}}" class="best-hand muted">翻牌后显示当前最佳牌型</view>
    <view wx:if="{{spectator || phase === 'showdown' || phase === 'settled'}}">
      <view wx:for="{{spectatorHands}}" wx:for-item="player" wx:key="seat" class="spectator-hand">
        <view class="spectator-hand-title">{{player.positionLabel || player.seat}} · {{player.nickname}}</view>
        <view class="best-hand">{{player.bestHand ? '当前最佳：' + player.bestHand.label : '等待公共牌'}}</view>
        <view class="card-row">
          <view wx:for="{{player.hand}}" wx:for-item="card" wx:key="id" class="texas-card small {{card.red ? 'red' : ''}}">{{card.label}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="card-row">
      <view wx:for="{{holeCards}}" wx:key="id" class="texas-card {{item.red ? 'red' : ''}}">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{!spectator && phase !== 'settled'}}" class="panel action-panel">
    <view class="section-title">{{isMyTurn ? '轮到你操作' : '等待其他玩家操作'}}</view>
    <view class="muted">{{currentBet === 0 ? '下注' : '加注到'}}：{{sliderValue}}{{selectedAllIn ? ' · All-in' : ''}}</view>
    <slider class="bet-slider" min="{{sliderMin}}" max="{{sliderMax}}" step="10" value="{{sliderValue}}" disabled="{{!isMyTurn || !sliderMax}}" activeColor="#f0b44d" bindchange="onSliderChange" />
    <view class="action-row">
      <button class="secondary-button" disabled="{{!isMyTurn}}" bindtap="onFold">弃牌</button>
      <button wx:if="{{canCheck}}" class="secondary-button" bindtap="onCheck">过牌</button>
      <button wx:if="{{canCall}}" class="secondary-button" bindtap="onCall">跟注 {{callAmount}}</button>
      <button class="primary-button" disabled="{{!isMyTurn || !sliderMax}}" bindtap="onCommit">{{selectedAllIn ? 'All-in' : (currentBet === 0 ? '下注' : '加注')}}</button>
    </view>
  </view>

        <view class="spectator-hand-title">{{player.positionLabel || player.seat}} · {{player.nickname}}</view>
        <view class="best-hand">{{player.bestHand ? '当前最佳：' + player.bestHand.label : '等待公共牌'}}</view>
  </view>
  <button wx:if="{{settlement && !showSettlement}}" class="settlement-summary-button" bindtap="onOpenSettlement">查看本局结算：{{settlement.winnerText}}</button>

  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
