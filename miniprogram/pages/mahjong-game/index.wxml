<view class="page mahjong-game-page">
  <view class="game-header"><view class="title">麻将对局</view><view class="muted">第 {{snapshot.public.handNumber}} 局 · 牌墙剩余 {{wallCount}} 张</view><view class="turn-status {{isResponsePhase ? 'response-phase' : isMyTurn ? 'my-turn' : ''}}">{{turnStatus}}</view></view>
  <view class="room-purpose-notice" role="note"><text class="room-purpose-title">测试学习交流声明</text><text>本房间仅用于游戏测试、学习与交流；虚拟积分仅供娱乐，不具有现金或财产价值。</text></view>
  <view wx:if="{{spectator}}" class="spectator-banner">观战模式 · 查看牌桌状态</view>
  <view class="mahjong-table" style="height:{{boardSize}}px">
    <view wx:for="{{wallSides}}" wx:key="position" class="mahjong-wall mahjong-wall-{{item.position}}"><view wx:for="{{item.tiles}}" wx:for-item="back" wx:key="id" class="tile-back"><view></view></view></view>
    <view wx:for="{{players}}" wx:key="seat" class="mahjong-seat mahjong-seat-{{item.position}} {{item.seat === currentTurn && !isResponsePhase ? 'current' : ''}} {{item.seat === ownSeat && canRespondNow ? 'responding' : ''}}">
      <view class="player-card"><view class="player-avatar">{{item.avatarLabel}}</view><view class="player-meta"><text class="player-name">{{item.nickname}}</text><text class="player-subtitle">{{item.seatLabel}} · {{item.score}}分</text></view><text wx:if="{{item.isDealer}}" class="player-badge dealer">庄</text><text wx:if="{{item.isListening}}" class="player-badge listening">听</text></view>
      <view wx:if="{{item.melds.length}}" class="seat-melds"><view wx:for="{{item.melds}}" wx:for-item="meld" wx:key="index" class="mahjong-meld"><text>{{meld.kind === 'chi' ? '吃' : meld.kind === 'peng' ? '碰' : meld.kind === 'concealed-kong' ? '暗杠' : '杠'}}</text><view class="meld-tiles"><template is="tileFace" wx:for="{{meld.tiles}}" wx:for-item="tile" wx:key="id" data="{{tile}}" /></view></view></view>
      <view wx:if="{{item.revealedHand.length && item.seat !== ownSeat}}" class="revealed-seat-hand"><template is="tileFace" wx:for="{{item.revealedHand}}" wx:for-item="tile" wx:key="id" data="{{tile}}" /></view>
      <view wx:if="{{item.seat === ownSeat && !spectator}}" class="own-hand" aria-label="我的手牌"><view wx:for="{{hand}}" wx:key="id" class="mahjong-tile-face {{item.tileClass}} {{item.selected ? 'selected' : ''}} {{item.listenOption ? 'listen-option' : ''}}" data-id="{{item.id}}" bindtap="onTileTap"><view wx:if="{{item.isNumbered}}" class="face-rank">{{item.rankDisplay}}</view><view wx:if="{{item.isNumbered && !item.isCharacters}}" class="face-motif"><view wx:for="{{item.motifs}}" wx:for-item="motif" wx:key="id" class="tile-motif {{item.tileClass}}" style="left:{{motif.left}}%;top:{{motif.top}}%"></view></view><view wx:if="{{item.isCharacters}}" class="face-character">萬</view><view wx:if="{{!item.isNumbered}}" class="face-honor">{{item.label}}</view><view class="face-suit">{{item.suitDisplay}}</view></view></view>
    </view>
    <block wx:for="{{players}}" wx:for-item="riverPlayer" wx:key="seat"><view wx:if="{{riverPlayer.discards.length}}" class="seat-river-pile seat-river-pile-{{riverPlayer.position}}" aria-label="{{riverPlayer.nickname}}打出的牌"><template is="tileFace" wx:for="{{riverPlayer.discards}}" wx:for-item="tile" wx:key="id" data="{{tile}}" /></view></block>
    <view wx:if="{{!spectator && isResponsePhase && (canRespondNow || canPass || isWaitingForPriority)}}" class="own-actions mahjong-action-prompt"><text class="prompt-title">{{isWaitingForPriority ? '等待优先玩家响应' : '选择响应'}}</text><button wx:if="{{canHu}}" class="primary-button" data-action="hu" bindtap="onAction">胡</button><button wx:if="{{canPeng}}" class="secondary-button" data-action="peng" bindtap="onAction">碰</button><view wx:if="{{canChi}}" class="chi-options"><button wx:for="{{chiOptions}}" wx:for-item="option" wx:key="key" class="chi-choice" data-action="chi" data-index="{{index}}" bindtap="onAction"><text>吃</text><view class="chi-tiles"><template is="tileFace" wx:for="{{option.tiles}}" wx:for-item="tile" wx:key="id" data="{{tile}}" /></view></button></view><button wx:if="{{canKong}}" class="secondary-button" data-action="exposed-kong" bindtap="onAction">杠</button><button wx:if="{{canPass}}" class="secondary-button" data-action="pass" bindtap="onAction">过</button></view>
    <view wx:if="{{!spectator && isMyTurn && snapshot.public.phase === 'playing' && !isListening}}" class="own-actions mahjong-action-prompt"><text class="prompt-title">轮到你出牌</text><button class="primary-button" data-action="discard" disabled="{{!selectedTileId || !canDiscard}}" bindtap="onAction">出牌</button><button wx:if="{{canListen}}" class="primary-button" data-action="listen" disabled="{{!canListenSelected}}" bindtap="onAction">听牌并出牌</button><button wx:if="{{canConcealedKong}}" class="secondary-button" data-action="concealed-kong" bindtap="onAction">暗杠</button><button wx:if="{{canAddedKong}}" class="secondary-button" data-action="added-kong" disabled="{{!selectedTileId}}" bindtap="onAction">补杠</button></view>
    <view wx:if="{{!spectator && isMyTurn && isListening && canHu}}" class="own-actions mahjong-action-prompt"><text class="prompt-title">摸到可胡牌</text><button class="primary-button" data-action="hu" bindtap="onAction">胡</button><button class="secondary-button" data-action="pass" bindtap="onAction">过，自动出牌</button></view>
    <view wx:if="{{animationStage}}" class="mahjong-animation {{animationStage}}"><view class="dice-cube">{{diceLabel}}</view><text>{{animationStage === 'dice' ? '庄家掷骰' : '正在发牌'}}</text><view wx:if="{{animationStage === 'deal'}}" class="dealing-tiles"><view class="tile-back"><view></view></view><view class="tile-back"><view></view></view><view class="tile-back"><view></view></view><view class="tile-back"><view></view></view></view></view>
  </view>
  <view wx:if="{{autoDiscardPending}}" class="auto-discard-note">听牌自动摸切中…</view>
  <view wx:if="{{settlement}}" class="panel settlement-panel"><view class="section-title">本局结束</view><view wx:if="{{settlement.type === 'draw'}}">流局 · 原庄家不变，自动掷骰开下一局</view><view wx:else>{{settlement.winnerNickname || settlement.winnerSeat}} 获胜 · {{settlement.winPattern === 'big-wind' ? '大风' : settlement.winPattern === 'bao' ? '胡宝' : settlement.type === 'self-draw' ? '自摸' : '点炮'}}</view><view wx:if="{{paymentRows.length}}" class="mahjong-payment-row"><text wx:for="{{paymentRows}}" wx:key="seat">{{item.nickname}} {{item.amountLabel}} </text></view><button wx:if="{{settlement.type !== 'draw' && ownSeat === snapshot.public.hostSeat}}" class="primary-button" data-action="next-hand" bindtap="onAction">开始下一局</button></view>
  <button class="leave-button" bindtap="onLeave">退出房间</button>
  <room-chat messages="{{chat}}" members="{{chatMembers}}" own-seat="{{ownSeat}}" bind:send="onChatSend" />
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>

<template name="tileFace">
  <view class="mahjong-tile-face compact {{tileClass}} {{isPendingDiscard ? 'pending-discard' : ''}}"><view wx:if="{{isNumbered}}" class="face-rank">{{rankDisplay}}</view><view wx:if="{{isNumbered && !isCharacters}}" class="face-motif"><view wx:for="{{motifs}}" wx:for-item="motif" wx:key="id" class="tile-motif {{tileClass}}" style="left:{{motif.left}}%;top:{{motif.top}}%"></view></view><view wx:if="{{isCharacters}}" class="face-character">萬</view><view wx:if="{{!isNumbered}}" class="face-honor">{{label}}</view><view class="face-suit">{{suitDisplay}}</view></view>
</template>
