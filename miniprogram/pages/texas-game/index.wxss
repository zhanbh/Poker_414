.texas-game-page {
  padding-top: 54rpx;
}

.game-header {
  margin-bottom: 20rpx;
}

.texas-game-table {
  position: relative;
  min-height: 760rpx;
  margin-top: 26rpx;
  overflow: visible;
  border: 2rpx solid #397a8b;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, #1d6a62 0%, #124b50 62%, #0e3442 100%);
  box-shadow: inset 0 0 0 12rpx rgba(10, 42, 54, .45), 0 18rpx 44rpx rgba(0, 0, 0, .25);
}

.texas-game-table::before {
  content: '';
  position: absolute;
  left: 8%;
  right: 8%;
  top: 10%;
  bottom: 10%;
  border: 2rpx solid rgba(157, 217, 229, .35);
  border-radius: 50%;
  pointer-events: none;
}

.texas-table-center {
  position: absolute;
  z-index: 1;
  top: 50%;
  left: 50%;
  display: flex;
  width: 56%;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
  transform: translate(-50%, -50%);
}

.texas-seat-position {
  position: absolute;
  z-index: 2;
  display: flex;
  width: 190rpx;
  min-height: 132rpx;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx;
  background: rgba(16, 35, 49, .8);
  border: 2rpx solid #397a8b;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, .22);
  transform: translate(-50%, -50%);
}

.texas-seat-A { top: 4%; left: 50%; }
.texas-seat-B { top: 15%; left: 84%; }
.texas-seat-C { top: 50%; left: 96%; transform: translate(-100%, -50%); }
.texas-seat-D { top: 85%; left: 84%; }
.texas-seat-E { top: 96%; left: 50%; transform: translate(-50%, -100%); }
.texas-seat-F { top: 85%; left: 16%; }
.texas-seat-G { top: 50%; left: 4%; transform: translate(0, -50%); }
.texas-seat-H { top: 15%; left: 16%; }
.texas-meta {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
  color: #d1e4eb;
  font-size: 22rpx;
}

.community-panel {
  margin-top: 16rpx;
}

.community-panel .section-title {
  color: #a9c4d1;
  font-size: 24rpx;
}

.card-row {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.texas-card {
  display: inline-flex;
  min-width: 62rpx;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  color: #132431;
  background: #f5f8fc;
  border: 2rpx solid #d6e2ea;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.texas-card.red {
  color: #c62828;
}

.texas-card.small {
  min-width: 52rpx;
  height: 70rpx;
  font-size: 24rpx;
}

.texas-player {
  gap: 6rpx;
  padding: 14rpx;
  background: rgba(16, 35, 49, .8);
  border: 2rpx solid #397a8b;
}

.texas-player.current {
  border-color: #ffd166;
  box-shadow: 0 0 0 2rpx rgba(255, 209, 102, .2);
}

.texas-player > view:first-child {
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
}

.texas-player .waiting {
  color: #9dd9e5;
}

.texas-player .seat {
  margin-right: 10rpx;
  color: #ffd166;
}

.texas-player .muted {
  font-size: 20rpx;
}

.texas-player-chip-area {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  min-height: 54rpx;
}

.texas-player-chip-area .muted {
  flex: 1;
}

.texas-chip-stack {
  position: relative;
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 48rpx;
}

.texas-chip {
  position: absolute;
  left: 2rpx;
  width: 26rpx;
  height: 9rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, .65);
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, .38), inset 0 0 0 3rpx rgba(255, 255, 255, .18);
}

.texas-chip-red { background: #d64d5b; }
.texas-chip-blue { background: #3d86c6; }
.texas-chip-green { background: #43a982; }
.texas-chip-black { background: #25323b; }
.texas-chip-purple { background: #9360bd; }

.texas-chip-flight {
  position: absolute;
  z-index: 6;
  display: flex;
  align-items: center;
  gap: 6rpx;
  pointer-events: none;
  transform: translate(-50%, -50%);
  animation: texas-chip-to-pot .72s cubic-bezier(.22, .72, .35, 1) both;
}

.texas-chip-flight .texas-chip {
  position: relative;
  left: auto;
  bottom: auto;
}

.texas-chip-flight text {
  color: #fff0b3;
  font-size: 20rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .65);
  white-space: nowrap;
}

.host {
  color: #f0b44d;
}

.folded {
  color: #ff9aa4;
}

.hand-panel,
.action-panel,
.settlement-panel {
  margin-top: 20rpx;
}

.spectator-hand {
  margin-top: 14rpx;
  padding: 14rpx;
  background: #1e5368;
  border-radius: 12rpx;
}

.spectator-hand-title {
  font-weight: 700;
}

.bet-slider {
  margin: 18rpx 0;
}

.action-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.action-row button {
  flex: 1;
  min-width: 160rpx;
}

.settlement-panel .primary-button {
  margin-top: 22rpx;
}

/* 手机端按横屏牌桌设计，避免牌桌和操作区纵向堆叠。 */
@media (orientation: landscape) {
  .texas-game-page {
    padding: 20rpx 28rpx 28rpx;
  }

  .game-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12rpx;
  }

  .texas-game-table {
    height: 66vh;
    min-height: 0;
    max-height: 720rpx;
    margin: 14rpx 0;
    border-radius: 42%;
  }

  .texas-table-center {
    width: 52%;
    gap: 6rpx;
  }

  .texas-meta {
    gap: 8rpx;
    font-size: 20rpx;
  }

  .community-panel {
    margin-top: 8rpx;
  }

  .card-row {
    gap: 5rpx;
    margin-top: 8rpx;
  }

  .texas-card {
    min-width: 48rpx;
    height: 68rpx;
    padding: 4rpx;
    font-size: 24rpx;
  }

  .texas-seat-position {
    width: 170rpx;
    min-height: 92rpx;
    gap: 4rpx;
    padding: 9rpx;
    border-radius: 11rpx;
    font-size: 20rpx;
  }

  .texas-player {
    gap: 4rpx;
    padding: 9rpx;
  }

  .texas-player .seat {
    max-width: 62%;
    margin-right: 4rpx;
    line-height: 1.15;
  }

  .texas-player .muted {
    font-size: 18rpx;
  }

  .hand-panel,
  .action-panel,
  .settlement-panel {
    margin-top: 12rpx;
  }

  .hand-panel,
  .action-panel,
  .settlement-panel {
    padding: 12rpx 16rpx;
  }

  .action-panel .section-title {
    display: inline-block;
    margin-right: 12rpx;
  }

  .bet-slider {
    margin: 8rpx 0;
  }

  .action-row {
    gap: 8rpx;
  }

  .action-row button {
    min-width: 140rpx;
  }
}

@keyframes texas-card-deal {
  from { opacity: 0; transform: translateY(-18rpx) scale(.84) rotate(-2deg); }
  to { opacity: 1; transform: translateY(0) scale(1) rotate(0); }
}

@keyframes texas-phase-in {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes texas-chip-to-pot {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(.75) rotate(-8deg); }
  12% { opacity: 1; }
  72% { left: 50%; top: 50%; opacity: 1; transform: translate(-50%, -50%) scale(1.05) rotate(3deg); }
  100% { left: 50%; top: 50%; opacity: 0; transform: translate(-50%, -50%) scale(.52) rotate(0); }
}

.texas-card-deal { animation: texas-card-deal .42s ease both; }
.phase-notice { min-height: 32rpx; color: #ffd166; font-size: 24rpx; font-weight: 700; animation: texas-phase-in .32s ease both; }
.best-hand { margin-top: 10rpx; color: #ffd166; }
.best-hand text { color: #fff0b3; font-weight: 700; }
.settlement-backdrop { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 30rpx; background: rgba(3, 15, 24, .76); }
.settlement-modal { width: 100%; padding: 32rpx; background: linear-gradient(145deg, #214d60, #122d3e); border: 3rpx solid #ffd166; border-radius: 22rpx; box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, .45); animation: texas-phase-in .25s ease both; }
.settlement-kicker { color: #9fc5ce; }
.settlement-title { margin: 8rpx 0 22rpx; color: #ffd166; font-size: 38rpx; font-weight: 800; }
.settlement-winner { margin-top: 14rpx; padding: 18rpx; background: rgba(255, 209, 102, .12); border: 2rpx solid rgba(255, 209, 102, .44); border-radius: 12rpx; }
.settlement-winner-name { color: #fff0b3; font-weight: 700; }
.settlement-hand { color: #ffd166; font-weight: 700; }
.settlement-modal button { margin-top: 22rpx; }
.settlement-summary-button { margin-top: 20rpx; color: #102331; background: #ffd166; font-weight: 700; }
@media (prefers-reduced-motion: reduce) {
  .texas-card-deal, .phase-notice, .settlement-modal, .texas-chip-flight { animation: none; }
}
