.access-page {
  padding-top: 100rpx;
}

.subtitle {
  font-size: 28rpx;
  margin-bottom: 36rpx;
}

.game-picker {
  display: flex;
  gap: 18rpx;
  margin: 0 8rpx 28rpx;
}

.game-card {
  flex: 1;
  min-height: 154rpx;
  background: #123244;
  border: 2rpx solid #2e7189;
  border-radius: 18rpx;
  padding: 20rpx;
}

.game-card.selected {
  background: #1e5368;
  border-color: #f0b44d;
  box-shadow: 0 0 0 2rpx rgba(240, 180, 77, .2);
}

.game-card-title {
  color: #f0b44d;
  font-size: 30rpx;
  font-weight: 700;
}

.game-card-description,
.game-card-meta {
  color: #c2d7df;
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 10rpx;
}

.game-card-meta {
  color: #8fb4c1;
  font-size: 20rpx;
}

.access-panel {
  margin: 0 8rpx;
}

.selected-game-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.selected-game-description {
  font-size: 24rpx;
  margin-bottom: 26rpx;
}

.field-label {
  color: #b8d0dc;
  font-size: 26rpx;
  margin: 10rpx 0;
}

.field-input {
  background: #0f2a3b;
  border: 1rpx solid #3a7990;
  border-radius: 12rpx;
  color: #fff;
  height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 22rpx;
}

.server-tip {
  font-size: 22rpx;
  margin: 28rpx 8rpx;
  word-break: break-all;
}
