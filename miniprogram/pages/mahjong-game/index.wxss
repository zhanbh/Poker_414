  .mahjong-seat-bottom .seat-melds { bottom: 14%; left: 32%; right: 2%; }
  .mahjong-discard-pile { top: 37%; right: 25%; bottom: 25%; left: 25%; gap: 2rpx; padding: 4rpx; }
  .discard-pile-title { font-size: 15rpx; }
