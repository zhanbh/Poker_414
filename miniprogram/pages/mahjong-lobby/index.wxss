.mahjong-lobby-page { padding-top: 30rpx; }
.mahjong-lobby-page .game-header { margin-bottom: 18rpx; }
.mahjong-lobby-table { position: relative; width: 100%; min-height: 0; margin-top: 28rpx; border: 2rpx solid #397a8b; border-radius: 22rpx; background: linear-gradient(145deg, #15504f, #17635d 55%, #123844); box-shadow: inset 0 0 0 12rpx rgba(8, 34, 45, .18), 0 18rpx 44rpx rgba(0, 0, 0, .25); }
.mahjong-lobby-felt { position: absolute; top: 37%; left: 24%; right: 24%; display: flex; flex-direction: column; align-items: center; gap: 10rpx; text-align: center; }
.mahjong-table-title { color: #ffd166; font-size: 38rpx; font-weight: 800; }
.mahjong-lobby-felt button { margin-top: 8rpx; }
.mahjong-lobby-seat { position: absolute; z-index: 2; display: flex; width: 32%; min-height: 104rpx; flex-direction: column; gap: 5rpx; padding: 10rpx; background: rgba(29, 75, 94, .96); border: 2rpx solid #397a8b; border-radius: 14rpx; box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, .18); }
.mahjong-lobby-seat-A { top: 2%; left: 50%; transform: translateX(-50%); }
.mahjong-lobby-seat-B { top: 50%; right: 2%; transform: translateY(-50%); }
.mahjong-lobby-seat-C { bottom: 2%; left: 50%; transform: translateX(-50%); }
.mahjong-lobby-seat-D { top: 50%; left: 2%; transform: translateY(-50%); }
.mahjong-lobby-seat .seat-title, .mahjong-lobby-seat .host { color: #ffd166; font-weight: 700; }
.mahjong-lobby-seat .seat-score { color: #b7d0d8; font-size: 18rpx; }
.mahjong-lobby-seat button { align-self: flex-start; min-height: 52rpx; margin: 0; padding: 0 14rpx; font-size: 22rpx; }
